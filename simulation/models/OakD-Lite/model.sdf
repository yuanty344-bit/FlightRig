<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="OakD-Lite">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <mass>0.061</mass>
        <inertia>
          <ixx>0.0000460804</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000055421</iyy>
          <iyz>0</iyz>
          <izz>0.0000436519</izz>
        </inertia>
      </inertial>
      <visual name="OakD-Lite/visual/body">
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <geometry><box><size>0.0175 0.091 0.028</size></box></geometry>
        <material>
          <ambient>0.12 0.14 0.17 1</ambient>
          <diffuse>0.12 0.14 0.17 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>
      <visual name="OakD-Lite/visual/rgb_lens">
        <pose>0.0124 -0.03 0.0188 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.08 0.15 1</ambient>
          <diffuse>0.03 0.08 0.15 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>
      <collision name="OakD-Lite/collision">
        <pose>0.00358 -0.03 0.014 0 0 0</pose>
        <geometry><box><size>0.0175 0.091 0.028</size></box></geometry>
      </collision>
      <sensor name="IMX214" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.01233 -0.03 0.01878 0 0 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
          </image>
          <clip>
            <near>0.1</near>
            <!-- The city worlds can span more than one kilometre.  RGB is a
                 visual stream, so keep distant buildings visible. -->
            <far>1500</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="StereoOV7251" type="depth_camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.01233 -0.03 0.01878 0 0 0</pose>
        <camera>
          <!-- Use the same registered field of view and 16:9 framing as the
               RGB stream.  Toggling RGB/depth now preserves image geometry. -->
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>depth_camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
